# ==========================================
# SkillNest LMS Backend Environment Variables
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/lms_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lms_db

# Security & JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Frontend Client URL (for CORS and reset links)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration (for course thumbnails, avatar pictures, videos & attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer SMTP - e.g. Ethereal, SendGrid, Gmail, AWS SES)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="SkillNest LMS" <noreply@skillnest.lms>

# Razorpay Payment Gateway (Test or Live API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
